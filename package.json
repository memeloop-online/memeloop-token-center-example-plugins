{
  "name": "@memeloop/mtc-health-intelligence",
  "version": "1.2.1",
  "description": "MTC model health and intelligence: extensible public feeds and signed operator UI",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "files": [
    "dist/server",
    "ui",
    "plugin.json",
    "schemas-health-intelligence.json",
    "README.md",
    "LICENSE",
    "plugin.wasm",
    "component-build.json"
  ],
  "exports": {
    "./server": "./dist/server/server/index.js",
    "./manifest": "./dist/server/manifestAdapter.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.build.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --exclude 'playground/**'",
    "check": "npm run typecheck && npm test && npm run build",
    "snapshot": "node dist/server/server/generateStaticSnapshot.js site/api/health-intelligence.json",
    "serve": "node dist/server/server/run.js",
    "verify:published": "node dist/server/server/verifyPublishedSnapshot.js",
    "build:playground": "node scripts/build-playground.mjs",
    "test:playground": "node --test playground/agent-loop.test.mjs playground/test/ui-unit.test.mjs playground/test/release-evidence.test.mjs",
    "test:playground:browser": "node --test playground/test/ui-browser.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.10.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "license": "Apache-2.0"
}
